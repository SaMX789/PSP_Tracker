<Window x:Class="SistemaMonitoreoProyectos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AS Consultoria Integral - PSP TRACKER" 
        Height="800" Width="1280"
        MinHeight="720" MinWidth="1024"
        WindowState="Maximized"
        Background="{StaticResource BrocheFondoVentana}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Panel Izquierdo: Lista de Proyectos/Actividades -->
            <ColumnDefinition Width="260"/>
            <!-- Área Central: Contenido Dinámico de las Vistas -->
            <ColumnDefinition Width="*"/>
            <!-- Panel Derecho: Menú de Navegación por Iconos -->
            <ColumnDefinition Width="65"/>
        </Grid.ColumnDefinitions>

        <!-- ========================================== -->
        <!-- PANEL IZQUIERDO: PROYECTOS Y ACTIVIDADES  -->
        <!-- ========================================== -->
        <Border Grid.Column="0" Background="{StaticResource BrocheFondoSecundario}" BorderBrush="{StaticResource BrocheBordeTarjeta}" BorderThickness="0,0,1,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Actividades" Style="{StaticResource EstiloTextoTituloGrande}" FontSize="20" Margin="0,0,0,20"/>
                <TextBlock Grid.Row="1" Text="PROYECTOS ACTIVOS" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,10"/>

                <!-- Lista de Proyectos/Actividades Activas con ScrollBar Delgado Personalizado -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="6"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ScrollBar">
                                        <Grid Background="Transparent">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb Width="6">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border x:Name="ThumbBorder" Background="{StaticResource BrocheBordeTarjeta}" CornerRadius="3"/>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource BrocheTextoSecundario}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>

                    <StackPanel x:Name="ContenedorProyectosActivos"/>
                </ScrollViewer>

                <!-- Botón Abrir Widget -->
                <Button Grid.Row="3" x:Name="BotonAgregarNuevaActividad" Style="{StaticResource EstiloBotonSecundario}" Height="45" Margin="0,10,0,0" Click="BotonAgregarNuevaActividad_Click_1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚡ " FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="ABRIR WIDGET" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- ÁREA CENTRAL: VISTA ACTUAL                -->
        <!-- ========================================== -->
        <Grid Grid.Column="1" Margin="24">
            <ContentControl x:Name="ControlContenidoDashboard"/>
        </Grid>

        <!-- ========================================== -->
        <!-- PANEL DERECHO: BARRA DE NAVEGACIÓN ICONOS -->
        <!-- ========================================== -->
        <Border Grid.Column="2" Background="{StaticResource BrocheFondoSecundario}" BorderBrush="{StaticResource BrocheBordeTarjeta}" BorderThickness="1,0,0,0" Padding="0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Avatar Usuario Top -->
                <Border Grid.Row="0" Width="36" Height="36" CornerRadius="18" Background="{StaticResource BrocheAcentoPrimario}" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <TextBlock Text="W" Foreground="#121214" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- En el Panel Derecho -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <Button x:Name="BotonNavegarOverview" Style="{StaticResource EstiloBotonSecundario}" Width="44" Height="44" Padding="0" Margin="0,0,0,12" ToolTip="Resumen Postmortem">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                    <Button x:Name="BotonNavegarTimeLog" Style="{StaticResource EstiloBotonSecundario}" Width="44" Height="44" Padding="0" Margin="0,0,0,12" ToolTip="Registro de Tiempo">
                        <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                    <Button x:Name="BotonNavegarDefectLog" Style="{StaticResource EstiloBotonSecundario}" Width="44" Height="44" Padding="0" Margin="0,0,0,12" ToolTip="Bitácora de Defectos">
                        <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                    </Button>
                </StackPanel>

                <!-- PANEL DERECHO: ICONOS DE EXPORTACIÓN Y CONFIGURACIÓN -->
<StackPanel Grid.Row="2" HorizontalAlignment="Center">
    
    <!-- Icono Hoja de Cálculo / Tabla (&#xE1D3;) -->
    <Button x:Name="BotonExportarCSV" 
            Style="{StaticResource EstiloBotonSecundario}" 
            Width="44" Height="44" Padding="0" 
            Margin="0,0,0,12" 
            ToolTip="Exportar Datos a CSV" 
            Click="BotonExportarCSV_Click">
        <TextBlock Text="&#xE1D3;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#10B981"/>
    </Button>

    <!-- Icono Documento Imprimible (&#xE8A5;) -->
    <Button x:Name="BotonConfiguracion" 
            Style="{StaticResource EstiloBotonSecundario}" 
            Width="44" Height="44" Padding="0" 
            ToolTip="Exportar Reporte PDF">
        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#60A5FA"/>
    </Button>

</StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>