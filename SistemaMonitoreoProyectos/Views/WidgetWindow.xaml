<Window x:Class="SistemaMonitoreoProyectos.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSP Tracker Widget" 
        Height="540" 
        Width="340"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseDown="Ventana_MouseDown">

    <Border x:Name="BordePrincipal" 
            Background="{StaticResource BrocheFondoVentana}" 
            BorderBrush="{StaticResource BrocheBordeTarjeta}" 
            BorderThickness="1" 
            CornerRadius="20" 
            Padding="20">
        <ContentControl x:Name="ControlContenidoVista"/>
    </Border>
</Window>