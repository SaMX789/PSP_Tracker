<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.WidgetCreateTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Encabezado del Widget con Menú de 3 Puntos -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="32" Height="4" Background="{StaticResource BrocheBordeTarjeta}" CornerRadius="2"/>
            </StackPanel>

            <!-- Menú de 3 Puntos a la derecha -->
            <Button x:Name="BotonOpcionesWidget" 
                    Width="26" 
                    Height="20" 
                    Style="{StaticResource EstiloBotonSecundario}" 
                    Padding="0" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Click="BotonOpcionesWidget_Click">
                <TextBlock Text="⋮" FontSize="14" FontWeight="Bold"/>
                <Button.ContextMenu>
                    <ContextMenu x:Name="MenuOpcionesTaskContext">
                        <MenuItem Header="🚪 Salir del Widget" Click="MenuItemSalirWidget_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- 1. Formulario de Entrada con ScrollBar Estilizado (6px) -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Width="6">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder" 
                                                                Background="{StaticResource BrocheBordeTarjeta}" 
                                                                CornerRadius="3"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource BrocheTextoSecundario}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>

            <StackPanel Margin="2,2,8,2">
                <!-- Campo: Título de la Actividad -->
                <TextBlock Text="Título de la actividad" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBox x:Name="TextoTituloActividad" 
                         Style="{StaticResource EstiloCampoTexto}" 
                         Height="36" 
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Margin="0,0,0,12"/>

                <!-- Campo: Descripción (Caja ampliada hacia abajo) -->
                <TextBlock Text="Descripción" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBox x:Name="TextoDescripcionActividad" 
                         Style="{StaticResource EstiloCampoTexto}" 
                         MinHeight="85" 
                         MaxHeight="120"
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalContentAlignment="Top" 
                         Padding="8,8"
                         Margin="0,0,0,12"/>

                <!-- Campo: Responsable -->
                <TextBlock Text="Responsable" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBox x:Name="TextoResponsable" 
                         Style="{StaticResource EstiloCampoTexto}" 
                         Height="36" 
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Margin="0,0,0,12"/>

                <!-- Campo: Tiempo Estimado (Horas) -->
                <TextBlock Text="Tiempo estimado (horas)" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBox x:Name="TextoTiempoEstimado" 
                         Style="{StaticResource EstiloCampoTexto}" 
                         Height="36" 
                         Text="0.0" 
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Margin="0,0,0,6"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Acciones Inferiores -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="BotonSiguiente" 
                    Content="SIGUIENTE  ➔" 
                    Style="{StaticResource EstiloBotonPrimario}" 
                    Height="42" 
                    Margin="0,0,0,10" 
                    Click="BotonSiguiente_Click"/>

            <Button x:Name="BotonCargarExistente" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Padding="4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↺ " Foreground="{StaticResource BrocheTextoSecundario}" FontSize="12"/>
                    <TextBlock Text="Continuar con una actividad ya creada" 
                               Foreground="{StaticResource BrocheTextoSecundario}" 
                               FontSize="12" 
                               TextDecorations="Underline" 
                               MouseDown="TextBlock_MouseDown"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>