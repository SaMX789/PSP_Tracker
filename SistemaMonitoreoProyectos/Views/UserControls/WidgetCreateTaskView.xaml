<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.WidgetCreateTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Encabezado del Widget -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="32" Height="4" Background="{StaticResource BrocheBordeTarjeta}" CornerRadius="2"/>
            </StackPanel>

            <Button x:Name="BotonOpcionesWidget" 
                    Width="26" 
                    Height="20" 
                    Style="{StaticResource EstiloBotonSecundario}" 
                    Padding="0" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Click="BotonOpcionesWidget_Click">
                <TextBlock Text="⋮" FontSize="14" FontWeight="Bold"/>
                <Button.ContextMenu>
                    <ContextMenu x:Name="MenuOpcionesTaskContext">
                        <MenuItem Header="🚪 Salir del Widget" Click="MenuItemSalirWidget_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- 1. Formulario Unificado -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Width="6">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder" Background="{StaticResource BrocheBordeTarjeta}" CornerRadius="3"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource BrocheTextoSecundario}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>

            <StackPanel Margin="2,2,8,2">
                <!-- Título -->
                <TextBlock Text="Título de la actividad" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBox x:Name="TextoTituloActividad" 
                         Style="{StaticResource EstiloCampoTexto}" 
                         Height="36" 
                         VerticalContentAlignment="Center" 
                         Padding="8,0" 
                         Margin="0,0,0,12"/>

                <!-- Descripción -->
                <TextBlock Text="Descripción" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBox x:Name="TextoDescripcionActividad" 
                         Style="{StaticResource EstiloCampoTexto}" 
                         MinHeight="55" 
                         MaxHeight="80" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalContentAlignment="Top" 
                         Padding="8,6" 
                         Margin="0,0,0,12"/>

                <!-- Responsable -->
                <TextBlock Text="Responsable" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBox x:Name="TextoResponsable" 
                         Style="{StaticResource EstiloCampoTexto}" 
                         Height="36" 
                         VerticalContentAlignment="Center" 
                         Padding="8,0" 
                         Margin="0,0,0,12"/>

                <!-- Tiempo Estimado Total (Horas) -->
                <TextBlock Text="Tiempo estimado total (horas)" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBox x:Name="TextoTiempoEstimado" 
                         Style="{StaticResource EstiloCampoTexto}" 
                         Height="36" 
                         Text="1.0" 
                         VerticalContentAlignment="Center" 
                         Padding="8,0" 
                         Margin="0,0,0,14"
                         GotFocus="TextoTiempoEstimado_GotFocus"
                         TextChanged="TextoTiempoEstimado_TextChanged"
                         PreviewTextInput="SoloDecimales_PreviewTextInput"
                         PreviewKeyDown="SinEspacios_PreviewKeyDown"/>

                <!-- SECCIÓN PLEGABLE DE FASES PSP -->
                <Expander x:Name="AcordeonPlanPSP" 
                          Header="📊 ¿Cuánto tiempo crees que te llevará..." 
                          Foreground="{StaticResource BrocheAcentoPrimario}" 
                          FontWeight="Bold" 
                          FontSize="12" 
                          Margin="0,2,0,10">
                    <StackPanel Margin="0,10,0,0">
                        
                        <!-- ENCABEZADO DE COLUMNAS DE CAMPOS -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Tiempo (h)" Style="{StaticResource EstiloTextoEtiqueta}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Err. Inyect." Style="{StaticResource EstiloTextoEtiqueta}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="Errores inyectados estimados"/>
                            <TextBlock Grid.Column="4" Text="Err. Remov." Style="{StaticResource EstiloTextoEtiqueta}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" ToolTip="Errores removidos estimados"/>
                        </Grid>

                        <!-- LISTA DE FASES CON TÍTULO ARRIBA Y CUADROS DE TEXTO ABAJO -->
                        <ItemsControl x:Name="ListaFasesPlan">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="0,4,0,6" Margin="0,0,0,4">
                                        <StackPanel>
                                            <!-- Nombre de la fase arriba del grupo de textos -->
                                            <TextBlock Text="{Binding NombreFaseDisplay}" 
                                                       Foreground="{StaticResource BrocheTextoPrincipal}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Margin="0,0,0,4"
                                                       TextWrapping="Wrap"/>

                                            <!-- Fila con los 3 cuadros de texto -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Horas (Acepta decimales) -->
                                                <TextBox Grid.Column="0" 
                                                         Text="{Binding TiempoEstimadoHorasTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource EstiloCampoTexto}" 
                                                         Height="26" 
                                                         Padding="2,0" 
                                                         FontSize="11" 
                                                         HorizontalContentAlignment="Center"
                                                         PreviewTextInput="SoloDecimales_PreviewTextInput"
                                                         PreviewKeyDown="SinEspacios_PreviewKeyDown"/>

                                                <!-- Errores Inyectados (Habilitado solo si tiempo > 0) -->
                                                <TextBox Grid.Column="2" 
                                                         Text="{Binding DefectosInyectadosTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         IsEnabled="{Binding PuedeEditarInyectados}"
                                                         Style="{StaticResource EstiloCampoTexto}" 
                                                         Height="26" 
                                                         Padding="2,0" 
                                                         FontSize="11" 
                                                         HorizontalContentAlignment="Center"
                                                         PreviewTextInput="SoloEnteros_PreviewTextInput"
                                                         PreviewKeyDown="SinEspacios_PreviewKeyDown"/>

                                                <!-- Errores Removidos (Habilitado solo si inyectados > 0) -->
                                                <TextBox Grid.Column="4" 
                                                         Text="{Binding DefectosRemovidosTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                         IsEnabled="{Binding PuedeEditarRemovidos}"
                                                         Style="{StaticResource EstiloCampoTexto}" 
                                                         Height="26" 
                                                         Padding="2,0" 
                                                         FontSize="11" 
                                                         HorizontalContentAlignment="Center"
                                                         PreviewTextInput="SoloEnteros_PreviewTextInput"
                                                         PreviewKeyDown="SinEspacios_PreviewKeyDown"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Botón Inferior -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="BotonSiguiente" 
                    Content="► CREAR E INICIAR" 
                    Style="{StaticResource EstiloBotonPrimario}" 
                    Height="42" 
                    Margin="0,0,0,10" 
                    Click="BotonSiguiente_Click"/>

            <Button x:Name="BotonCargarExistente" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Padding="4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↺ " Foreground="{StaticResource BrocheTextoSecundario}" FontSize="12"/>
                    <TextBlock Text="Continuar con una actividad ya creada" 
                               Foreground="{StaticResource BrocheTextoSecundario}" 
                               FontSize="12" 
                               TextDecorations="Underline" 
                               MouseDown="TextBlock_MouseDown"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>