<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.ActivityOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado de la Actividad -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="/  APP WEB 1" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBlock Text="Resumen de Actividad - Postmortem" Style="{StaticResource EstiloTextoTituloGrande}"/>
                <TextBlock Text="Análisis detallado de rendimiento y precisión de estimaciones." Style="{StaticResource EstiloTextoSubtitulo}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#1C2B20" BorderBrush="#2D5A39" BorderThickness="1" CornerRadius="12" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓ " Foreground="#4ADE80" FontWeight="Bold"/>
                    <TextBlock Text="COMPLETADO" Foreground="#4ADE80" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Panel Principal de Métrica y Gráficos -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna Izquierda: Tiempos y Defectos -->
            <StackPanel Grid.Column="0">
                <!-- Seccion Métricas de Tiempo -->
                <Border Style="{StaticResource EstiloTarjetaBase}" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="⏱ " FontSize="16"/>
                            <TextBlock Text="Métricas de Tiempo" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>

                        <!-- Fila 1: Estimado vs Real -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#18181B" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="TIEMPO ESTIMADO" Style="{StaticResource EstiloTextoEtiqueta}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="TextoTiempoEstimadoHoras" Text="3.5" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrocheTextoPrincipal}"/>
                                        <TextBlock Text=" horas" FontSize="14" Foreground="{StaticResource BrocheTextoSecundario}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TextoTiempoEstimadoMinutos" Text="(210 min)" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#18181B" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="TIEMPO REAL EFECTIVO" Style="{StaticResource EstiloTextoEtiqueta}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="TextoTiempoRealHoras" Text="3.8" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrocheAcentoPrimario}"/>
                                        <TextBlock Text=" horas" FontSize="14" Foreground="{StaticResource BrocheTextoSecundario}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TextoTiempoRealMinutos" Text="(228 min)" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Fila 2: Desviación -->
                        <Border Background="#18181B" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel HorizontalAlignment="Left">
                                    <TextBlock Text="DESVIACIÓN" Style="{StaticResource EstiloTextoEtiqueta}"/>
                                    <TextBlock x:Name="TextoPorcentajeDesviacion" Text="+8.5%" FontSize="22" FontWeight="Bold" Foreground="#FF6B6B" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#202B42" CornerRadius="8" Padding="10,6">
                                    <TextBlock Text="✓ Dentro del rango aceptable (±10%)" Foreground="#60A5FA" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Fila 3: Retrabajo e Interrupciones -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#18181B" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="PORCENTAJE DE RETRABAJO" Style="{StaticResource EstiloTextoEtiqueta}"/>
                                    <TextBlock x:Name="TextoPorcentajeRetrabajo" Text="12%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrocheTextoPrincipal}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TextoTiempoRetrabajo" Text="TIEMPO DE RETRABAJO: 15 min" Style="{StaticResource EstiloTextoEtiqueta}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#18181B" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="INTERRUPCIONES TOTALES" Style="{StaticResource EstiloTextoEtiqueta}"/>
                                    <TextBlock x:Name="TextoTotalInterrupciones" Text="03" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrocheTextoPrincipal}" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TextoTiempoPerdidoInterrupciones" Text="TIEMPO PERDIDO: 15 min" Style="{StaticResource EstiloTextoEtiqueta}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Tarjeta Calidad y Defectos -->
                <Border Style="{StaticResource EstiloTarjetaBase}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="🐞 " FontSize="16"/>
                            <TextBlock Text="Calidad y Defectos" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="DEFECTOS TOTALES" Style="{StaticResource EstiloTextoEtiqueta}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextoDefectosTotales" Text="01" FontSize="36" FontWeight="Bold" Foreground="#FF4D4D" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="DEFECTOS CORREGIDOS" Style="{StaticResource EstiloTextoEtiqueta}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TextoDefectosCorregidos" Text="01" FontSize="36" FontWeight="Bold" Foreground="{StaticResource BrocheAcentoPrimario}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Columna Derecha: Distribución por Fase -->
            <Border Grid.Column="2" Style="{StaticResource EstiloTarjetaBase}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock Text="📊 " FontSize="16"/>
                        <TextBlock Text="Distribución por Fase" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold" FontSize="16"/>
                    </StackPanel>

                    <!-- Lista de Fases y sus minutos -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Planeación" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TextoTiempoPlaneacion" Text="20 min (8.7%)" Foreground="{StaticResource BrocheTextoSecundario}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Construcción" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TextoTiempoConstruccion" Text="160 min (70.1%)" Foreground="{StaticResource BrocheTextoSecundario}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Pruebas" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TextoTiempoPruebas" Text="48 min (21.2%)" Foreground="{StaticResource BrocheTextoSecundario}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- Total Registrado Bottom -->
                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <TextBlock Text="Total Registrado" Foreground="{StaticResource BrocheTextoSecundario}"/>
                        <TextBlock x:Name="TextoTotalRegistradoFases" Text="228 min" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>