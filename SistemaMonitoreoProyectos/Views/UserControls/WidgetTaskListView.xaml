<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.WidgetTaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="30" Height="4" Background="{StaticResource BrocheBordeTarjeta}" CornerRadius="2" Margin="0,0,0,8"/>
                <TextBlock Text="ACTIVE TASK" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrocheTextoSecundario}"/>
            </StackPanel>

            <Border HorizontalAlignment="Right" Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrocheAcentoPrimario}">
                <TextBlock Text="👤" Foreground="#121214" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
            </Border>
        </Grid>

        <!-- Buscador de Actividades (Conectado con evento TextChanged) -->
        <TextBox Grid.Row="1" 
                 x:Name="TextoBuscadorActividad" 
                 Style="{StaticResource EstiloCampoTexto}" 
                 Tag="🔍 Buscar actividades..." 
                 Foreground="{StaticResource BrocheTextoPrincipal}" 
                 Margin="0,0,0,15"
                 TextChanged="TextoBuscadorActividad_TextChanged"/>

        <!-- Contenedor Dinámico de Tareas -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContenedorListaTareas" />
            </ScrollViewer>

            <!-- Botón flotante (+) -->
            <Button x:Name="BotonFlotanteNuevaTarea" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Width="48" 
                    Height="48" 
                    Style="{StaticResource EstiloBotonPrimario}" 
                    Padding="0" 
                    Margin="0,0,10,10" 
                    Click="BotonFlotanteNuevaTarea_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="24" Background="{TemplateBinding Background}">
                            <TextBlock Text="+" FontSize="24" FontWeight="Bold" Foreground="#121214" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>