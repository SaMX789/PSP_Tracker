<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.WidgetTaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Encabezado de la Lista de Tareas -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Lista de Actividades" 
                       Foreground="{StaticResource BrocheTextoPrincipal}" 
                       FontWeight="Bold" 
                       FontSize="14" 
                       VerticalAlignment="Center"/>

            <!-- Menú de 3 Puntos -->
            <Button x:Name="BotonOpcionesWidget" 
                    Width="26" 
                    Height="20" 
                    Style="{StaticResource EstiloBotonSecundario}" 
                    Padding="0" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Click="BotonOpcionesWidget_Click">
                <TextBlock Text="⋮" FontSize="14" FontWeight="Bold"/>
                <Button.ContextMenu>
                    <ContextMenu x:Name="MenuOpcionesTaskContext">
                        <MenuItem Header="🚪 Salir del Widget" Click="MenuItemSalirWidget_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- 1. Buscador con Placeholder / Marca de agua -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <TextBox x:Name="TextoBuscadorActividad" 
                     Style="{StaticResource EstiloCampoTexto}" 
                     Foreground="{StaticResource BrocheTextoPrincipal}" 
                     Height="36"
                     TextChanged="TextoBuscadorActividad_TextChanged"/>

            <TextBlock Text="🔍 Buscar actividades..." 
                       Foreground="{StaticResource BrocheTextoSecundario}" 
                       VerticalAlignment="Center" 
                       Margin="12,0,0,0" 
                       IsHitTestVisible="False" 
                       Opacity="0.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=TextoBuscadorActividad}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 2. Contenedor de Tarjetas con ScrollBar Delgado (6px) -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Width="6">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder" 
                                                                Background="{StaticResource BrocheBordeTarjeta}" 
                                                                CornerRadius="3"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource BrocheTextoSecundario}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>

            <!-- StackPanel donde el C# dibuja dinámicamente las tarjetas -->
            <StackPanel x:Name="ContenedorListaTareas" Margin="0,0,8,0"/>
        </ScrollViewer>

        <!-- 3. Botón inferior para crear nueva tarea -->
        <Button Grid.Row="3" 
                x:Name="BotonFlotanteNuevaTarea" 
                Content="+ NUEVA TAREA" 
                Style="{StaticResource EstiloBotonPrimario}" 
                Height="40" 
                Margin="0,10,0,0" 
                Click="BotonFlotanteNuevaTarea_Click"/>
    </Grid>
</UserControl>