<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.TimeLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="/  APP WEB 1  /  TIME LOG" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBlock Text="Registro de Tiempo" Style="{StaticResource EstiloTextoTituloGrande}"/>
                <TextBlock Text="Desglose detallado de horas invertidas por fase y actividad." Style="{StaticResource EstiloTextoSubtitulo}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource EstiloTarjetaBase}" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📅 " FontSize="12"/>
                    <TextBlock Text="Semana 42" Foreground="{StaticResource BrocheTextoPrincipal}" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tabla DataGrid de Registros de Tiempo -->
        <Border Grid.Row="1" Style="{StaticResource EstiloTarjetaBase}" Padding="0">
            <ListView x:Name="ListaRegistrosTiempo" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrocheTextoPrincipal}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="FECHA/DÍA" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FechaFormatted}" Foreground="{StaticResource BrocheTextoPrincipal}" Margin="8,4"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="FASE" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#27272A" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Fase}" Foreground="{StaticResource BrocheTextoPrincipal}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="ACTIVIDAD" Width="360">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Descripcion}" Foreground="{StaticResource BrocheTextoPrincipal}" Margin="8,4"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="TIEMPO (MIN)" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MinutosEfectivos}" Foreground="{StaticResource BrocheTextoPrincipal}" HorizontalAlignment="Right" Margin="8,4"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="TOTAL" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalAcumuladoFormatted}" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold" HorizontalAlignment="Right" Margin="8,4"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Pie de Tabla: Total -->
        <Border Grid.Row="2" Style="{StaticResource EstiloTarjetaBase}" Margin="0,10,0,0" Padding="16,12">
            <Grid>
                <TextBlock Text="Tiempo Total Registrado" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold"/>
                <TextBlock x:Name="TextoTiempoTotalTimeLog" Text="228 min" Foreground="{StaticResource BrocheAcentoPrimario}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>