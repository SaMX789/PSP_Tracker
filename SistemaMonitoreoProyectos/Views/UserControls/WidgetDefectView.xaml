<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.WidgetDefectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Encabezado con Menú 3 Puntos (⋮) y Cerrar (✕) -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TextoRelojDefecto" 
                       Text="00:00:00" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource BrocheTextoPrincipal}"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Botón de 3 Puntos (Opciones) - Corregido con Padding="0" y alineación -->
                <Button x:Name="BotonOpciones" 
                        Width="28" 
                        Height="28" 
                        Style="{StaticResource EstiloBotonSecundario}" 
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,0,6,0"
                        Click="BotonOpciones_Click"
                        ToolTip="Opciones del defecto">
                    <TextBlock Text="⋮" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MenuOpciones">
                            <MenuItem Header="💾 Guardar y atrás" Click="MenuItemGuardarAtras_Click"/>
                            <Separator/>
                            <MenuItem Header="🗑 Eliminar defecto" Click="MenuItemEliminar_Click" Foreground="#FF453A"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1. Formulario de Campos -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="2,2,8,2">
                <TextBlock Text="Descripción del Problema" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,6"/>
                <TextBox x:Name="TextoDescripcionDefecto" 
                         Style="{StaticResource EstiloCampoTexto}" 
                         MinHeight="72" 
                         MaxHeight="100" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalContentAlignment="Top" 
                         Padding="8,8"
                         Margin="0,0,0,14"/>

                <!-- NUEVO CAMPO: TIPO DE DEFECTO -->
                <TextBlock Text="🏷️ Tipo de Defecto" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,6"/>
                <ComboBox x:Name="DesplegableTipoDefecto" 
                          Height="36" 
                          Margin="0,0,0,14" 
                          DisplayMemberPath="DisplayComboBox" 
                          SelectedValuePath="Id"
                          ToolTip="Categoría del defecto introducido"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Fases reacomodadas en 2 columnas para ahorrar espacio -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="➔ Fase Origen" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="DesplegableFaseOrigen" Height="36" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="🔍 Fase Detección" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="DesplegableFaseDeteccion" Height="36" DisplayMemberPath="Nombre" SelectedValuePath="Id"/>
                    </StackPanel>
                </Grid>

                <Rectangle Height="1" Fill="{StaticResource BrocheBordeTarjeta}" Margin="0,16,0,12"/>

                <!-- Botón Agregar Sub-Defecto -->
                <Button x:Name="BotonAgregarSubDefecto" 
                        Height="38" 
                        Margin="0,0,0,4"
                        Background="#FFB3AD" 
                        Foreground="#68000A" 
                        BorderThickness="0" 
                        Cursor="Hand"
                        Click="BotonAgregarSubDefecto_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+ " FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="AGREGAR OTRO DEFECTO" FontWeight="Bold" FontSize="12"/>
                    </StackPanel>
                </Button>

                <!-- Sub-Bolitas Anidadas -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,4,0,10">
                    <StackPanel x:Name="ContenedorSubDefectos" Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ScrollViewer>
            </StackPanel>
        </ScrollViewer>

        <!-- 2. Botón Principal: Marcar Como Listo (Resuelto -> Verde) -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Button x:Name="BotonMarcarListo" 
                    Style="{StaticResource EstiloBotonPrimario}" 
                    Height="42" 
                    Click="BotonMarcarListo_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="💾 " FontSize="13"/>
                    <TextBlock Text="MARCAR COMO LISTO" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>