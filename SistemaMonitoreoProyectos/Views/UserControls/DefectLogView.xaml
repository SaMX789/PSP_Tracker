<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.DefectLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Encabezado -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock x:Name="TextoRutaDefectLog" Text="/ PROYECTO / DEFECT LOG" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
                <TextBlock Text="Bitácora y Análisis de Fuga de Calidad" Style="{StaticResource EstiloTextoTituloGrande}"/>
            </StackPanel>
        </Grid>

        <!-- 1. Tabla ListView con Scroll Horizontal y Multilínea Perfecta -->
        <Border Grid.Row="1" Style="{StaticResource EstiloTarjetaBase}" Padding="0" ClipToBounds="True">
            <ListView x:Name="ListaDefectos" 
                      Background="Transparent" 
                      BorderThickness="0" 
                      Foreground="{StaticResource BrocheTextoPrincipal}"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                
                <ListView.Resources>
                    <!-- Estilo para Encabezados de Columna -->
                    <Style TargetType="GridViewColumnHeader">
                        <Setter Property="Background" Value="#16161A"/>
                        <Setter Property="Foreground" Value="{StaticResource BrocheTextoSecundario}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrocheBordeTarjeta}"/>
                    </Style>

                    <!-- Estilo para Filas de la Tabla -->
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource BrocheTextoPrincipal}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#242429"/>
                        <Setter Property="Padding" Value="0,6"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" 
                                            Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            Padding="{TemplateBinding Padding}">
                                        <GridViewRowPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#25252B"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2A2A33"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <!-- ScrollBars Delgados Personalizados -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter Property="Width" Value="8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.Thumb>
                                                        <Thumb Width="8">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border x:Name="ThumbBorder" Background="#3F3F46" CornerRadius="4"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource BrocheAcentoPrimario}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid Background="Transparent">
                                                <Track x:Name="PART_Track">
                                                    <Track.Thumb>
                                                        <Thumb Height="8">
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border x:Name="ThumbBorder" Background="#3F3F46" CornerRadius="4"/>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource BrocheAcentoPrimario}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="FECHA" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FechaRegistroFormatted}" Foreground="{StaticResource BrocheTextoPrincipal}" Margin="8,6" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="DESCRIPCIÓN" Width="420">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- USAMOS DOCKPANEL PARA RESTRICCIÓN EXACTA DE ANCHO -->
                                    <DockPanel Margin="{Binding MarginJerarquia}" VerticalAlignment="Center">
                                        
                                        <!-- Chip SUB Limpio -->
                                        <Border DockPanel.Dock="Left"
                                                Background="#33261A" 
                                                BorderBrush="#F59E0B" 
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Padding="6,2" 
                                                Margin="0,0,8,0" 
                                                VerticalAlignment="Center" 
                                                Visibility="{Binding EsAnidadoVisibility}">
                                            <TextBlock Text="SUB" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Texto Multilínea Ajustado Exactamente a las Palabras -->
                                        <TextBlock Text="{Binding DescripcionError}" 
                                                   Foreground="{StaticResource BrocheTextoPrincipal}" 
                                                   TextWrapping="Wrap" 
                                                   VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="TIPO" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TipoDefectoTexto}" Foreground="{StaticResource BrocheTextoSecundario}" FontSize="12" Margin="8,6" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="ORIGEN ➔ DETECCIÓN" Width="190">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RutaFases}" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="SemiBold" Margin="8,6" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="IMPACTO FUGA" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E22" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="8,6">
                                        <TextBlock Text="{Binding ImpactoFugaTexto}" Foreground="{Binding ImpactoFugaColor}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="TIEMPO CORRECCIÓN" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TiempoCorreccionFormatted}" Foreground="{StaticResource BrocheTextoPrincipal}" HorizontalAlignment="Right" Margin="8,6" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="FECHA RESOLUCIÓN" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FechaResolucionFormatted}" Foreground="{StaticResource BrocheTextoSecundario}" Margin="8,6" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="ESTADO" Width="110">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding EstadoColor}" FontWeight="Bold" HorizontalAlignment="Center" Margin="8,6" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- 2. Pie de Tabla -->
        <Border Grid.Row="2" Style="{StaticResource EstiloTarjetaBase}" Margin="0,10,0,0" Padding="16,12">
            <Grid>
                <TextBlock Text="Tiempo Total Invertido en Retrabajo" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold"/>
                <TextBlock x:Name="TextoTiempoTotalDefectos" Text="0 min" Foreground="#FF4D4D" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>