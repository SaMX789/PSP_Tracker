<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.DefectLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <!-- Encabezado -->
<Grid Grid.Row="0" Margin="0,0,0,20">
    <StackPanel HorizontalAlignment="Left">
        <TextBlock x:Name="TextoRutaDefectLog" Text="/ PROYECTO / DEFECT LOG" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,4"/>
        <TextBlock Text="Bitácora y Análisis de Fuga de Calidad" Style="{StaticResource EstiloTextoTituloGrande}"/>
    </StackPanel>
</Grid>

        <!-- Tabla ListView -->
        <Border Grid.Row="1" Style="{StaticResource EstiloTarjetaBase}" Padding="0">
            <ListView x:Name="ListaDefectos" Background="Transparent" BorderThickness="0" Foreground="{StaticResource BrocheTextoPrincipal}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="DESCRIPCIÓN" Width="240">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="&#xE76C; " FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#FF4D4D" VerticalAlignment="Center" Visibility="{Binding EsAnidadoVisibility}"/>
                                        <TextBlock Text="{Binding DescripcionError}" Foreground="{StaticResource BrocheTextoPrincipal}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="TIPO (PSP)" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TipoDefectoTexto}" Foreground="{StaticResource BrocheTextoSecundario}" FontSize="12" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="ORIGEN ➔ DETECCIÓN" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RutaFases}" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="IMPACTO FUGA" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E22" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding ImpactoFugaTexto}" Foreground="{Binding ImpactoFugaColor}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="TIEMPO CORRECCIÓN" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TiempoCorreccionFormatted}" Foreground="{StaticResource BrocheTextoPrincipal}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Header="ESTADO" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstadoTexto}" Foreground="{Binding EstadoColor}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Pie de Tabla -->
        <Border Grid.Row="2" Style="{StaticResource EstiloTarjetaBase}" Margin="0,10,0,0" Padding="16,12">
            <Grid>
                <TextBlock Text="Tiempo Total Invertido en Retrabajo" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold"/>
                <TextBlock x:Name="TextoTiempoTotalDefectos" Text="0 min" Foreground="#FF4D4D" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>