<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.WidgetCompactView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Border x:Name="ContenedorCompacto"
            Background="{StaticResource BrocheFondoTarjeta}"
            BorderBrush="{StaticResource BrocheBordeTarjeta}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="10,6,14,6"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            Cursor="Hand"
            ToolTip="Doble clic para restaurar">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            
            <!-- Avatar / Icono -->
            <Border Width="26" Height="26" CornerRadius="13" Background="#2E2E35" Margin="0,0,8,0">
                <TextBlock Text="👤" Foreground="{StaticResource BrocheTextoPrincipal}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/>
            </Border>

            <!-- Título de la tarea -->
            <TextBlock x:Name="TextoNombreActividadMinimizada" 
                       Text="APP WEB 1" 
                       Foreground="{StaticResource BrocheTextoPrincipal}" 
                       FontWeight="Bold" 
                       FontSize="13" 
                       MaxWidth="110"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

            <!-- Separador Vertical -->
            <Rectangle Width="1" Height="14" Fill="{StaticResource BrocheBordeTarjeta}" Margin="10,0"/>

            <!-- Cronómetro compacto -->
            <TextBlock x:Name="TextoRelojMinimizado" 
                       Text="00:00:00" 
                       Foreground="{StaticResource BrocheTextoPrincipal}" 
                       FontWeight="Bold" 
                       FontSize="14" 
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>