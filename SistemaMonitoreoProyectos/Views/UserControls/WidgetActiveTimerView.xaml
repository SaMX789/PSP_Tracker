<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.WidgetActiveTimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. Encabezado con Nombre de Actividad, Opciones y Botón Minimizar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrocheFondoTarjeta}" Margin="0,0,8,0">
                    <TextBlock Text="👤" Foreground="{StaticResource BrocheTextoSecundario}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                </Border>
                <TextBlock x:Name="TextoNombreActividadActiva" Text="APP WEB 1" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Botones de Acción en el Encabezado -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Botón de 3 Puntos para Opciones -->
                <Button x:Name="BotonOpcionesWidget" Width="26" Height="20" Style="{StaticResource EstiloBotonSecundario}" Padding="0" Margin="0,0,6,0" Click="BotonOpcionesWidget_Click">
                    <TextBlock Text="⋮" FontSize="14" FontWeight="Bold"/>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MenuOpcionesContext">
    <MenuItem Header="💾 Guardar y Salir" Click="MenuItemGuardarYSalir_Click"/>
    <MenuItem Header="📋 Guardar y Lista de Actividades" Click="MenuItemGuardarYLista_Click"/>
    <Separator/>
    <MenuItem Header="Finalizar Actividad" Click="MenuItemFinalizarActividadWidget_Click"/>
</ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Botón Minimizar -->
                <Button x:Name="BotonMinimizarWidget" Width="30" Height="20" Style="{StaticResource EstiloBotonSecundario}" Padding="0" Click="BotonMinimizarWidget_Click">
                    <TextBlock Text="-" FontSize="14" FontWeight="Bold"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1. Barra Indicadora de Arrastre/Encabezado -->
        <Border Grid.Row="1" Width="32" Height="4" Background="{StaticResource BrocheBordeTarjeta}" CornerRadius="2" HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <!-- 2. Display Digital y Desplegable dentro de ScrollViewer Delgado (6px) -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Width="6">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="ThumbBorder" 
                                                                Background="{StaticResource BrocheBordeTarjeta}" 
                                                                CornerRadius="3"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource BrocheTextoSecundario}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ScrollViewer.Resources>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6">
                <!-- Display Digital del Cronómetro -->
                <TextBlock x:Name="TextoRelojCronometro" 
                           Text="00:00:00" 
                           FontSize="50" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource BrocheTextoPrincipal}" 
                           HorizontalAlignment="Center"/>

                <!-- Selector de Fase con Indicadores Verde/Rojo -->
                <ComboBox x:Name="DesplegableFase"
                          Width="210"
                          Height="36"
                          HorizontalAlignment="Center"
                          FontSize="14"
                          FontWeight="Bold"
                          Foreground="#1E2026"
                          Background="#FFFFFF"
                          BorderBrush="#D1D5DB"
                          BorderThickness="1"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Margin="0,14,0,10">
                    
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding IconoEstado}" 
                                           Foreground="{Binding ColorEstado}" 
                                           FontWeight="Bold" 
                                           Margin="0,0,8,0"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding Nombre}" 
                                           Foreground="#1E2026"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                    <ComboBox.Resources>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#FFFFFF"/>
                            <Setter Property="Foreground" Value="#1E2026"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E5E7EB"/>
                                    <Setter Property="Foreground" Value="#1E2026"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2563EB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Botones de Control del Tiempo y Defectos -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BotonIniciarReloj" 
                        Grid.Column="0" 
                        Content="► INICIAR" 
                        Style="{StaticResource EstiloBotonPrimario}" 
                        Height="42" 
                        FontSize="12"
                        Padding="0"
                        Click="BotonIniciarReloj_Click"/>

                <Button x:Name="BotonPausarReloj" 
                        Grid.Column="2" 
                        Content="❚❚ PAUSAR" 
                        Style="{StaticResource EstiloBotonSecundario}" 
                        Height="42" 
                        FontSize="12"
                        Padding="0"
                        ToolTipService.ShowOnDisabled="True"
                        Click="BotonPausarReloj_Click"/>
            </Grid>

            <!-- Botón Principal + DEFECTO -->
            <Grid HorizontalAlignment="Stretch" Margin="0,12,0,0">
                <Button x:Name="BotonAgregarDefecto" 
                        Content="🐞  + DEFECTO" 
                        Style="{StaticResource EstiloBotonInsigniaDefecto}" 
                        Height="42" 
                        Width="Auto"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="16,0"
                        Click="BotonAgregarDefecto_Click"/>
            </Grid>

            <!-- Contenedor Horizontal para Bolitas (Rojas / Verdes) -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Disabled" 
                          Margin="0,10,0,0"
                          Focusable="False">
                <StackPanel x:Name="ContenedorInsigniasDefectos" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"/>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</UserControl>