<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.WidgetActiveTimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado con Nombre de Actividad, Opciones y Botón Minimizar -->
<Grid Grid.Row="0" Margin="0,0,0,10">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrocheFondoTarjeta}" Margin="0,0,8,0">
            <TextBlock Text="👤" Foreground="{StaticResource BrocheTextoSecundario}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
        </Border>
        <TextBlock x:Name="TextoNombreActividadActiva" Text="APP WEB 1" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Botones de Acción en el Encabezado -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <!-- Botón de 3 Puntos para Opciones -->
        <Button x:Name="BotonOpcionesWidget" Width="26" Height="20" Style="{StaticResource EstiloBotonSecundario}" Padding="0" Margin="0,0,6,0" Click="BotonOpcionesWidget_Click">
            <TextBlock Text="⋮" FontSize="14" FontWeight="Bold"/>
            <Button.ContextMenu>
                <ContextMenu x:Name="MenuOpcionesContext">
                    <MenuItem Header="💾 Guardar y Salir" Click="MenuItemGuardarYSalir_Click"/>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>

        <!-- Botón Minimizar -->
        <Button x:Name="BotonMinimizarWidget" Width="30" Height="20" Style="{StaticResource EstiloBotonSecundario}" Padding="0" Click="BotonMinimizarWidget_Click">
            <TextBlock Text="-" FontSize="14" FontWeight="Bold"/>
        </Button>
    </StackPanel>
</Grid>
        <Border Grid.Row="1" Width="40" Height="4" Background="{StaticResource BrocheBordeTarjeta}" CornerRadius="2" Margin="0,0,0,20"/>

        <!-- Display Digital del Cronómetro -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TextoRelojCronometro" Text="00:00:00" FontSize="56" FontWeight="Bold" Foreground="{StaticResource BrocheTextoPrincipal}" HorizontalAlignment="Center"/>

           <ComboBox x:Name="DesplegableFase"
          Width="210"
          Height="36"
          HorizontalAlignment="Center"
          FontSize="14"
          FontWeight="Bold"
          Foreground="#1E2026"
          Background="#FFFFFF"
          BorderBrush="#D1D5DB"
          BorderThickness="1"
          HorizontalContentAlignment="Center"
          VerticalContentAlignment="Center"
          Margin="0,15,0,15">
    
    <!-- Plantilla visual para mostrar el estado Verde/Rojo -->
    <ComboBox.ItemTemplate>
        <DataTemplate>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <TextBlock Text="{Binding IconoEstado}" 
                           Foreground="{Binding ColorEstado}" 
                           FontWeight="Bold" 
                           Margin="0,0,8,0"
                           FontSize="13"/>
                <TextBlock Text="{Binding Nombre}" 
                           Foreground="#1E2026"/>
            </StackPanel>
        </DataTemplate>
    </ComboBox.ItemTemplate>

    <ComboBox.Resources>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E2026"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E5E7EB"/>
                    <Setter Property="Foreground" Value="#1E2026"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </ComboBox.Resources>
</ComboBox>
        </StackPanel>

        <!-- Botones de Control del Tiempo y Defectos -->
        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BotonIniciarReloj" Grid.Column="0" Content="► INICIAR" Style="{StaticResource EstiloBotonPrimario}" Height="42" Click="BotonIniciarReloj_Click"/>
                <Button x:Name="BotonPausarReloj" Grid.Column="2" Content="❚❚ PAUSAR" Style="{StaticResource EstiloBotonSecundario}" Height="42" Click="BotonPausarReloj_Click"/>
            </Grid>

            <!-- Botón Destacado + Defecto -->
            <Button x:Name="BotonAgregarDefecto" Style="{StaticResource EstiloBotonDefecto}" Height="45">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🐞 " FontSize="14"/>
                    <TextBlock Text="+ DEFECTO" FontSize="14"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>