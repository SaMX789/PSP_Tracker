<UserControl x:Class="SistemaMonitoreoProyectos.Views.UserControls.WidgetActiveTimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado con Nombre de Actividad y Botón Minimizar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource BrocheFondoTarjeta}" Margin="0,0,8,0">
                    <TextBlock Text="👤" Foreground="{StaticResource BrocheTextoSecundario}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                </Border>
                <TextBlock x:Name="TextoNombreActividadActiva" Text="APP WEB 1" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="BotonMinimizarWidget" HorizontalAlignment="Right" Width="30" Height="20" Style="{StaticResource EstiloBotonSecundario}" Padding="0" Click="BotonMinimizarWidget_Click">
                <TextBlock Text="-" FontSize="14" FontWeight="Bold"/>
            </Button>
        </Grid>

        <Border Grid.Row="1" Width="40" Height="4" Background="{StaticResource BrocheBordeTarjeta}" CornerRadius="2" Margin="0,0,0,20"/>

        <!-- Display Digital del Cronómetro -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TextoRelojCronometro" Text="00:00" FontSize="56" FontWeight="Bold" Foreground="{StaticResource BrocheTextoPrincipal}" HorizontalAlignment="Center"/>

            <!-- Selector de Fase actual -->
            <ComboBox x:Name="DesplegableFase" Style="{StaticResource EstiloDesplegable}" Width="180" HorizontalAlignment="Center" Margin="0,20,0,0" SelectedIndex="0">
                <ComboBoxItem Content="Planeación"/>
                <ComboBoxItem Content="Diseño"/>
                <ComboBoxItem Content="Construcción"/>
                <ComboBoxItem Content="Pruebas"/>
            </ComboBox>
        </StackPanel>

        <!-- Botones de Control del Tiempo y Defectos -->
        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BotonIniciarReloj" Grid.Column="0" Content="► INICIAR" Style="{StaticResource EstiloBotonPrimario}" Height="42"/>
                <Button x:Name="BotonPausarReloj" Grid.Column="2" Content="❚❚ PAUSAR" Style="{StaticResource EstiloBotonSecundario}" Height="42"/>
            </Grid>

            <!-- Botón Destacado + Defecto -->
            <Button x:Name="BotonAgregarDefecto" Style="{StaticResource EstiloBotonDefecto}" Height="45">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🐞 " FontSize="14"/>
                    <TextBlock Text="+ DEFECTO" FontSize="14"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>