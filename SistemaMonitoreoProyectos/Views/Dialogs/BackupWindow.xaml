<Window x:Class="SistemaMonitoreoProyectos.Views.Dialogs.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Respaldos y Restauración" 
        Height="480" Width="550"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Border Background="{StaticResource BrocheFondoTarjeta}" BorderBrush="{StaticResource BrocheBordeTarjeta}" BorderThickness="1" CornerRadius="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource BrocheAcentoPrimario}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Respaldar e Importar Actividades" Style="{StaticResource EstiloTextoTituloGrande}" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BotonCerrar" Style="{StaticResource EstiloBotonSecundario}" Width="28" Height="28" Padding="0" HorizontalAlignment="Right" Click="BotonCerrar_Click">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </Button>
            </Grid>

            <!-- Controles de Selección -->
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
    <CheckBox x:Name="ChkSeleccionarTodos" Content="Seleccionar Todas" Foreground="{StaticResource BrocheTextoPrincipal}" FontWeight="Bold" VerticalAlignment="Center" Click="ChkSeleccionarTodos_Click"/>
    
    <!-- Enlace clicable hacia la carpeta en Windows -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0" Cursor="Hand" MouseLeftButtonDown="AbrirCarpetaBackups_Click" ToolTip="Abrir carpeta en el Explorador de Windows">
        <TextBlock Text="&#xE723;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource BrocheAcentoPrimario}" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBlock x:Name="TextoRutaBackups" Text="/Backups" Foreground="{StaticResource BrocheAcentoPrimario}" FontSize="11" VerticalAlignment="Center" TextDecorations="Underline"/>
    </StackPanel>
</StackPanel>

            <!-- Lista de Actividades con Checkbox -->
            <Border Grid.Row="2" Background="#16161A" BorderBrush="{StaticResource BrocheBordeTarjeta}" BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContenedorActividadesSeleccion"/>
                </ScrollViewer>
            </Border>

            <!-- Botones de Acción -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Button x:Name="BotonImportar" Style="{StaticResource EstiloBotonSecundario}" Height="38" Padding="16,0" HorizontalAlignment="Left" Click="BotonImportar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Importar Backup (.json)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BotonExportar" Style="{StaticResource EstiloBotonPrimario}" Height="38" Padding="16,0" HorizontalAlignment="Right" Click="BotonExportar_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Exportar Seleccionadas" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>