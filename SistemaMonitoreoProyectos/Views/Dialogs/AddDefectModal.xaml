<UserControl x:Class="SistemaMonitoreoProyectos.Views.Dialogs.AddDefectModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado con Cronómetro de Corrección y Botón Cerrar -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="TextoTiempoCorreccion" Text="00:05:51" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrocheTextoPrincipal}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            
            <Button x:Name="BotonCerrarModal" HorizontalAlignment="Right" Width="30" Height="30" Style="{StaticResource EstiloBotonSecundario}" Padding="0">
                <TextBlock Text="✕" FontSize="13" FontWeight="Bold"/>
            </Button>
        </Grid>

        <!-- Formulario de Entrada del Defecto -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,5">

                <!-- Campo: Descripción del Problema -->
                <TextBlock Text="Descripción del Problema" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,6"/>
                <TextBox x:Name="TextoDescripcionError" Style="{StaticResource EstiloCampoTexto}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,14"/>

                <!-- Campo: Fase Origen -->
                <TextBlock Text="➔ Fase Origen" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,6"/>
                <ComboBox x:Name="DesplegableFaseOrigen" Style="{StaticResource EstiloDesplegable}" SelectedIndex="2" Margin="0,0,0,14">
                    <ComboBoxItem Content="Planeación"/>
                    <ComboBoxItem Content="Diseño"/>
                    <ComboBoxItem Content="Construcción"/>
                    <ComboBoxItem Content="Pruebas"/>
                </ComboBox>

                <!-- Campo: Fase Detección -->
                <TextBlock Text="🔍 Fase Detección" Style="{StaticResource EstiloTextoEtiqueta}" Margin="0,0,0,6"/>
                <ComboBox x:Name="DesplegableFaseDeteccion" Style="{StaticResource EstiloDesplegable}" SelectedIndex="3" Margin="0,0,0,14">
                    <ComboBoxItem Content="Planeación"/>
                    <ComboBoxItem Content="Diseño"/>
                    <ComboBoxItem Content="Construcción"/>
                    <ComboBoxItem Content="Pruebas"/>
                </ComboBox>

                <!-- Checkbox para Anidación de Defectos -->
                <CheckBox x:Name="CheckEsAnidado" Content="Es un defecto anidado (causado por otro error)" Foreground="{StaticResource BrocheTextoSecundario}" FontSize="12" Margin="0,0,0,8"/>
                <ComboBox x:Name="DesplegableDefectoPadre" Style="{StaticResource EstiloDesplegable}" Visibility="Collapsed" Margin="0,0,0,10"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Acciones Inferiores -->
        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <!-- Botón Agregar Otro Defecto -->
            <Button x:Name="BotonAgregarOtroDefecto" Style="{StaticResource EstiloBotonDefecto}" Height="42" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="+ " FontSize="16"/>
                    <TextBlock Text="AGREGAR OTRO DEFECTO" FontSize="13"/>
                </StackPanel>
            </Button>

            <!-- Botón Marcar Como Listo -->
            <Button x:Name="BotonMarcarComoListo" Content="💾 MARCAR COMO LISTO" Style="{StaticResource EstiloBotonPrimario}" Height="45"/>
        </StackPanel>
    </Grid>
</UserControl>